# Optional. The site defaults to the live Supabase project (anon key + an
# insert-only RLS policy) in src/lib/supabase/server.ts. Set these only to
# point at a different project or to use a service-role key instead.
ATLAS_SUPABASE_URL=https://your-project.supabase.co
ATLAS_SUPABASE_KEY=your-anon-or-service-role-key
